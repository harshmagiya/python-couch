  "weakness_tags": [
    {
      "tag": "quadratic_string_building",
      "severity": "medium",
      "evidence": ["01_basics/ex02_word_frequencies"],
      "note": "Char-by-char `s += chunk` in a loop is O(n^2); use a list + ''.join(...) once."
    },
    {
      "tag": "bare_except",
      "severity": "high",
      "evidence": ["01_basics/ex04_read_int_lines"],
      "note": "`except:` swallows real bugs (KeyboardInterrupt, MemoryError). Catch the specific exception, usually ValueError here."
    },
    {
      "tag": "debug_prints_in_final_code",
      "severity": "medium",
      "evidence": ["01_basics/ex04_read_int_lines", "01_basics/ex05_balanced_brackets"],
      "note": "Strip `print(...)` calls before final run; replace with proper error/return value."
    },
    {
      "tag": "dict_keys_verbose_check",
      "severity": "low",
      "evidence": ["01_basics/ex02_word_frequencies", "02_collections/ex01_group_by_length"],
      "note": "Use `key in d`, not `key in d.keys()`. Same semantics, less noise."
    },
    {
      "tag": "shadow_builtins",
      "severity": "medium",
      "evidence": ["02_collections/ex19_total_covered"],
      "note": "Avoid `for range in ...`, `list = ...`, `id = ...`. Rename to `r`, `xs`, `obj_id`."
    },
    {
      "tag": "quadratic_list_membership",
      "severity": "medium",
      "evidence": ["02_collections/ex04_unique_preserve_order", "02_collections/ex09_first_nonrepeating"],
      "note": "`if x in some_list` inside a loop is O(n^2). Use a `set` for membership tracking; preserve order with a separate result list."
    },
    {
      "tag": "manual_index_loop",
      "severity": "low",
      "evidence": ["02_collections/ex07_bigram_frequencies"],
      "note": "`while i < n: ...; i += 1` over a list should usually be `for i in range(n)` or `for x in xs`."
    },
    {
      "tag": "control_flow_complexity",
      "severity": "medium",
      "evidence": ["02_collections/ex02_top_k_frequencies"],
      "note": "Nested while/for/else/break trees for a single transform is a smell; usually a `sorted(..., key=...)` does the job in a few lines."
    }
  ],
